# Planned configuration: copy to repository-root .env only when it does not exist.
# Vite in apps/web must set envDir to the repository root and keep envPrefix=VITE_.
# Backend loads this file explicitly; relative data paths anchor to repository root.
# Implement and validate these keys in the corresponding service before use.
VITE_API_BASE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:5173
STORAGE_ROOT=./storage
DATASET_ROOT=./datasets
APP_TIMEZONE=Asia/Bangkok
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_INSPECTION_VIEWS=12
MAX_REQUEST_MB=40
MAX_ROTATION_DEG=360
ROTATION_STEP_DEG=30
# API products.simulation_defaults exposes validated public rotation limits.
# Decision evidence images are always required; this flag controls extra locator frames only.
SAVE_ROTATION_FRAMES=false
# Thresholds are product-specific in the local product config, not universal.
